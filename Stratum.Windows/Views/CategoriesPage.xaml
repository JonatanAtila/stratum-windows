<Page
    x:Class="Stratum.Windows.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stratum.Windows.Views">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewCategoryBox" Grid.Column="0" PlaceholderText="Nova categoria"
                     MaxLength="32" KeyDown="NewCategoryBox_KeyDown" />
            <Button Grid.Column="1" Content="Adicionar" Click="AddButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <ListView x:Name="CategoryList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="★" FontSize="18" Foreground="Goldenrod"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding CountText}" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Content="↑" Tag="{Binding}" Click="UpButton_Click" ToolTipService.ToolTip="Subir" />
                            <Button Content="↓" Tag="{Binding}" Click="DownButton_Click" ToolTipService.ToolTip="Descer" />
                            <Button Content="Padrão" Tag="{Binding}" Click="DefaultButton_Click" ToolTipService.ToolTip="Categoria padrão para novas contas" />
                            <Button Content="Renomear" Tag="{Binding}" Click="RenameButton_Click" />
                            <Button Content="Excluir" Tag="{Binding}" Click="DeleteButton_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" />
    </Grid>
</Page>
