<Page
    x:Class="Stratum.Windows.Views.AuthenticatorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stratum.Windows.Views">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AuthCardBrush" Color="#CCFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AuthCardBrush" Color="#B82B2B2B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityInverted" Invert="True" />
            <local:NullToVisibilityConverter x:Key="NullToVisibility" />
            <local:NullToVisibilityConverter x:Key="NullToVisibilityInverted" Invert="True" />
            <SolidColorBrush x:Key="TotpProgressBrush" Color="#5B8DB8" />

            <ItemsPanelTemplate x:Key="AuthDefaultPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="306" ItemHeight="116" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="AuthCompactPanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="306" ItemHeight="84" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="AuthTilePanel">
                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="150" ItemHeight="142" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="AuthDefaultTemplate">
                <Border Width="294" Height="104"
                        Background="{ThemeResource AuthCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Tapped="Card_Tapped" Tag="{Binding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2" Padding="14,8,8,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                                    <Border CornerRadius="16" Background="{Binding AvatarBrush}"
                                            Visibility="{Binding CustomIcon, Converter={StaticResource NullToVisibilityInverted}}">
                                        <TextBlock Text="{Binding AvatarLetter}" FontSize="16" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding CustomIcon}" Width="30" Height="30"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding CustomIcon, Converter={StaticResource NullToVisibility}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{Binding Issuer}" FontWeight="SemiBold" FontSize="14"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Username}" Opacity="0.65" FontSize="11"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <Button Grid.Column="2" Content="&#x22EE;" FontSize="18"
                                        Background="Transparent" BorderThickness="0"
                                        Width="40" Height="36" VerticalAlignment="Center"
                                        Tag="{Binding}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copiar código" Tag="{Binding}" Click="CopyButton_Click" />
                                            <MenuFlyoutItem Text="Próximo código" Tag="{Binding}" Click="NextButton_Click"
                                                            Visibility="{Binding IsHotp, Converter={StaticResource BoolToVisibility}}" />
                                            <MenuFlyoutItem Text="Mostrar código QR" Tag="{Binding}" Click="QrButton_Click" />
                                            <MenuFlyoutItem Text="Editar" Tag="{Binding}" Click="EditButton_Click" />
                                            <MenuFlyoutItem Text="Excluir" Tag="{Binding}" Click="DeleteButton_Click" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding DisplayCode}" FontFamily="Consolas" FontSize="32"
                                       FontWeight="SemiBold" FlowDirection="LeftToRight"
                                       Margin="46,0,0,0" IsTextSelectionEnabled="True" />
                        </StackPanel>

                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding Period}"
                                     Value="{Binding ProgressValue}" Height="3"
                                     Background="Transparent"
                                     Foreground="{ThemeResource TotpProgressBrush}"
                                     Visibility="{Binding IsHotp, Converter={StaticResource BoolToVisibilityInverted}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AuthCompactTemplate">
                <Border Width="294" Height="72"
                        Background="{ThemeResource AuthCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Tapped="Card_Tapped" Tag="{Binding}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="10" Padding="12,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
                                <Border CornerRadius="14" Background="{Binding AvatarBrush}"
                                        Visibility="{Binding CustomIcon, Converter={StaticResource NullToVisibilityInverted}}">
                                    <TextBlock Text="{Binding AvatarLetter}" FontSize="14" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding CustomIcon}" Width="26" Height="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding CustomIcon, Converter={StaticResource NullToVisibility}}" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding Issuer}" FontWeight="SemiBold" FontSize="13"
                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Username}" Opacity="0.65" FontSize="11"
                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding DisplayCode}" FontFamily="Consolas" FontSize="21"
                                       FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True" />

                            <Button Grid.Column="3" Content="&#x22EE;" FontSize="16"
                                    Background="Transparent" BorderThickness="0"
                                    Width="36" Height="32" VerticalAlignment="Center"
                                    Tag="{Binding}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copiar código" Tag="{Binding}" Click="CopyButton_Click" />
                                        <MenuFlyoutItem Text="Próximo código" Tag="{Binding}" Click="NextButton_Click"
                                                        Visibility="{Binding IsHotp, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuFlyoutItem Text="Mostrar código QR" Tag="{Binding}" Click="QrButton_Click" />
                                        <MenuFlyoutItem Text="Editar" Tag="{Binding}" Click="EditButton_Click" />
                                        <MenuFlyoutItem Text="Excluir" Tag="{Binding}" Click="DeleteButton_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="{Binding Period}"
                                     Value="{Binding ProgressValue}" Height="3"
                                     Background="Transparent"
                                     Foreground="{ThemeResource TotpProgressBrush}"
                                     Visibility="{Binding IsHotp, Converter={StaticResource BoolToVisibilityInverted}}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AuthTileTemplate">
                <Border Width="140" Height="130"
                        Background="{ThemeResource AuthCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Tapped="Card_Tapped" Tag="{Binding}">
                    <Grid Padding="12,10,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="30" Height="30">
                                <Border CornerRadius="15" Background="{Binding AvatarBrush}"
                                        Visibility="{Binding CustomIcon, Converter={StaticResource NullToVisibilityInverted}}">
                                    <TextBlock Text="{Binding AvatarLetter}" FontSize="15" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding CustomIcon}" Width="28" Height="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding CustomIcon, Converter={StaticResource NullToVisibility}}" />
                            </Grid>

                            <Button Grid.Column="2" Content="&#x22EE;" FontSize="15"
                                    Background="Transparent" BorderThickness="0"
                                    Width="32" Height="28" VerticalAlignment="Top"
                                    Tag="{Binding}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copiar código" Tag="{Binding}" Click="CopyButton_Click" />
                                        <MenuFlyoutItem Text="Próximo código" Tag="{Binding}" Click="NextButton_Click"
                                                        Visibility="{Binding IsHotp, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuFlyoutItem Text="Mostrar código QR" Tag="{Binding}" Click="QrButton_Click" />
                                        <MenuFlyoutItem Text="Editar" Tag="{Binding}" Click="EditButton_Click" />
                                        <MenuFlyoutItem Text="Excluir" Tag="{Binding}" Click="DeleteButton_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding Issuer}" FontWeight="SemiBold" FontSize="13"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Text="{Binding DisplayCode}" FontFamily="Consolas" FontSize="22"
                                   FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="True" />
                        <ProgressBar Grid.Row="3" Minimum="0" Maximum="{Binding Period}" Margin="-12,0,-4,0"
                                     Value="{Binding ProgressValue}" Height="3"
                                     Background="Transparent"
                                     Foreground="{ThemeResource TotpProgressBrush}"
                                     Visibility="{Binding IsHotp, Converter={StaticResource BoolToVisibilityInverted}}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Add" Label="Adicionar" Click="AddButton_Click">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Conta manual" Click="AddManual_Click" />
                        <MenuFlyoutItem Text="Colar URI otpauth/motp" Click="AddUri_Click" />
                        <MenuFlyoutItem Text="Ler QR de imagem" Click="AddQrImage_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="Atualizar" Click="RefreshButton_Click" />
            <AppBarButton Label="Bloquear" Click="LockButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72E;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Pesquisar emissor ou usuário"
                     TextChanged="Filter_Changed" />
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" HorizontalAlignment="Stretch"
                      PlaceholderText="Categoria" SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="SortBox" Grid.Column="2" HorizontalAlignment="Stretch"
                      SelectionChanged="SortBox_SelectionChanged">
                <ComboBoxItem Content="Nome (A–Z)" Tag="IssuerAsc" />
                <ComboBoxItem Content="Nome (Z–A)" Tag="IssuerDesc" />
                <ComboBoxItem Content="Mais copiados" Tag="CopyCount" />
                <ComboBoxItem Content="Menos copiados" Tag="CopyCountAsc" />
                <ComboBoxItem Content="Ordem personalizada" Tag="Custom" />
            </ComboBox>
        </Grid>

        <InfoBar x:Name="BackupReminderBar" Grid.Row="2" IsOpen="False" IsClosable="False"
                 Severity="Warning" Title="Backup pendente"
                 Message="Há alterações ainda sem backup.">
            <InfoBar.ActionButton>
                <Button Content="Fazer backup" Click="BackupReminderButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <GridView x:Name="AuthList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="False"
                  DragItemsCompleted="AuthList_DragItemsCompleted">
        </GridView>

        <StackPanel x:Name="EmptyState" Grid.Row="3" Spacing="8" MaxWidth="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Nenhuma conta por aqui" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Adicione sua primeira conta manualmente, colando uma URI ou importando um backup."
                       TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="4" IsOpen="False" IsClosable="True" Severity="Informational" />
    </Grid>
</Page>
