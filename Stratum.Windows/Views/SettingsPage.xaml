<Page
    x:Class="Stratum.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="14" Padding="16" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="Aparência" FontSize="20" FontWeight="Bold" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="ThemeBox" Grid.Row="0" Grid.Column="0" Header="Tema" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Sistema" Tag="System" />
                    <ComboBoxItem Content="Claro" Tag="Light" />
                    <ComboBoxItem Content="Escuro" Tag="Dark" />
                </ComboBox>
                <ComboBox x:Name="BackdropBox" Grid.Row="0" Grid.Column="1" Header="Efeito de fundo" HorizontalAlignment="Stretch"
                          SelectionChanged="BackdropBox_SelectionChanged">
                    <ComboBoxItem Content="Mica (padrão)" Tag="Mica" />
                    <ComboBoxItem Content="Acrílico (transparente)" Tag="Acrylic" />
                    <ComboBoxItem Content="Sólido (sem efeitos)" Tag="Solid" />
                </ComboBox>

                <ComboBox x:Name="ViewModeBox" Grid.Row="1" Grid.Column="0" Header="Modo de exibição" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Padrão" Tag="Default" />
                    <ComboBoxItem Content="Compacto" Tag="Compact" />
                    <ComboBoxItem Content="Ladrilhos" Tag="Tile" />
                </ComboBox>
                <ComboBox x:Name="GroupingBox" Grid.Row="1" Grid.Column="1" Header="Agrupamento dos dígitos" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Sem agrupar" Tag="None" />
                    <ComboBoxItem Content="A cada 2 dígitos" Tag="Two" />
                    <ComboBoxItem Content="A cada 3 dígitos" Tag="Three" />
                    <ComboBoxItem Content="A cada 4 dígitos" Tag="Four" />
                    <ComboBoxItem Content="Metades (123 456)" Tag="Halves" />
                    <ComboBoxItem Content="Terços" Tag="Thirds" />
                </ComboBox>

                <CheckBox x:Name="ShowUsernamesCheck" Grid.Row="2" Grid.Column="0" Content="Mostrar nomes de usuário" VerticalAlignment="Center" />
                <CheckBox x:Name="ShowUncategorisedCheck" Grid.Row="2" Grid.Column="1" Content="Filtro Sem categoria" VerticalAlignment="Center" />
                <CheckBox x:Name="TapToRevealCheck" Grid.Row="3" Grid.Column="0" Content="Ocultar códigos até tocar" VerticalAlignment="Center"
                          Checked="TapToRevealCheck_Changed" Unchecked="TapToRevealCheck_Changed" />
                <CheckBox x:Name="TapToCopyCheck" Grid.Row="3" Grid.Column="1" Content="Tocar copia o código" VerticalAlignment="Center" />
                <ComboBox x:Name="RevealDurationBox" Grid.Row="4" Grid.Column="0" Header="Tempo visível após tocar" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="5 segundos" Tag="5" />
                    <ComboBoxItem Content="10 segundos" Tag="10" />
                    <ComboBoxItem Content="30 segundos" Tag="30" />
                </ComboBox>
                <CheckBox x:Name="SkipToNextCheck" Grid.Row="4" Grid.Column="1" Content="Mostrar próximo código no fim do período" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                <CheckBox x:Name="MinimizeToTrayCheck" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="Minimizar para a bandeja" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Segurança" FontSize="20" FontWeight="Bold" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox x:Name="AutoLockBox" Grid.Row="0" Grid.Column="0" Header="Bloqueio automático" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Desativado" Tag="0" />
                    <ComboBoxItem Content="1 minuto" Tag="1" />
                    <ComboBoxItem Content="5 minutos" Tag="5" />
                    <ComboBoxItem Content="15 minutos" Tag="15" />
                    <ComboBoxItem Content="30 minutos" Tag="30" />
                </ComboBox>
                <CheckBox x:Name="HelloCheck" Grid.Row="0" Grid.Column="1" Content="Desbloquear com Windows Hello"
                          VerticalAlignment="Bottom" Margin="0,0,0,5"
                          Checked="HelloCheck_Changed" Unchecked="HelloCheck_Changed" />
                <TextBlock x:Name="DbPasswordState" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Definir / alterar senha" Click="ChangePasswordButton_Click" />
                    <Button Content="Remover senha" Click="RemovePasswordButton_Click" />
                    <Button Content="Bloquear agora" Click="LockNowButton_Click" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Dados" FontSize="20" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Zerar contadores de cópia" Click="ResetCopyCountsButton_Click" />
            </StackPanel>

            <TextBlock Text="Sobre" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Stratum para Windows 1.0.0 — gerenciador de autenticação de dois fatores (TOTP, HOTP, mOTP, Steam, Yandex). Adicione contas manualmente, por URI, QR de imagem ou importando um backup; os códigos se atualizam sozinhos a cada período e um toque copia para a área de transferência. Organize com categorias, proteja o banco com senha ou Windows Hello e mantenha backups criptografados (.stratum) intercambiáveis com o app Android."
                       TextWrapping="Wrap" Opacity="0.8" />
            <TextBlock x:Name="VersionText" Opacity="0.6" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8"><Run Text="Núcleo, criptografia, formato de backup e pack de ícones: projeto original Stratum para Android, criado por " /><Hyperlink Click="CreatorLink_Click"><Run Text="jamiemh" /></Hyperlink><Run Text=". Todo o crédito vai para o projeto original. Licença: GPL-3.0-only." /></TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Abrir repositório (versão Windows)" Click="GithubButton_Click" />
                <Button Content="Projeto original (Android)" Click="OriginalButton_Click" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
