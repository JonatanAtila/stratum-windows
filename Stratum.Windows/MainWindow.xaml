<Window
    x:Class="Stratum.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar customizada: faz parte do fluxo do Mica -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0"
              ColumnSpacing="12" Background="Transparent" DoubleTapped="AppTitleBar_DoubleTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleBarIcon" Grid.Column="0" Width="20" Height="20"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Stratum" FontSize="13"
                       VerticalAlignment="Center" Opacity="0.9" />
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavAuthenticators" Content="Autenticadores" Tag="auth">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCategories" Content="Categorias" Tag="categories">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Tag" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavBackup" Content="Backup e importação" Tag="backup">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Content="Configurações" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
